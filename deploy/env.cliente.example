# Env do compose de UM cliente. Copie p/ deploy/.env.cliente e preencha.
#   docker compose --env-file deploy/.env.cliente -f deploy/docker-compose.cliente.yml up -d
# (deploy/.env.cliente é ignorado pelo git — não comitar segredos.)

# --- Domínios (DNS já apontando pra esta VPS) ---
APP_DOMAIN=app.clientex.com.br
EVOLUTION_DOMAIN=evolution.clientex.com.br
ACME_EMAIL=voce@clientex.com.br          # e-mail do Let's Encrypt (TLS)

# --- Imagem do painel (build por cliente da Fase 2) ---
PAINEL_IMAGE=ghcr.io/oguedrive-hash/facilita-painel:cliente_x

# --- Tenant (config.ts EXIGE; ORG_ID = o mesmo do seed) ---
DEFAULT_ORG_ID=
DEFAULT_INSTANCE_NAME=cliente_x
ADMIN_WHATSAPP_NUMBER=

# --- Supabase do cliente (Passo 2) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Evolution (criada por este compose) ---
EVOLUTION_API_KEY=          # gerar 32 chars novo (= AUTHENTICATION_API_KEY)
EVOLUTION_DB_PASSWORD=      # gerar novo

# --- OpenAI / ElevenLabs ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Cron ---
CRON_SECRET=               # gerar novo por cliente

TZ=America/Sao_Paulo
