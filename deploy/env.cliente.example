# Variáveis do servidor do Beba Mais. Copie para deploy/.env.cliente e preencha.
#   docker compose --env-file deploy/.env.cliente -f deploy/docker-compose.cliente.yml up -d
# (deploy/.env.cliente é ignorado pelo git — nunca commitar segredos.)
# Para gerar segredos: openssl rand -hex 32

# --- Endereço do painel (o DNS já precisa apontar para esta VPS) ---
APP_DOMAIN=atendimento.bebamais.com.br
ACME_EMAIL=                 # e-mail para o certificado HTTPS (Let's Encrypt)

# --- Imagem do painel (gerada pelo GitHub Actions) ---
PAINEL_IMAGE=ghcr.io/oguedrive-hash/bebamais-painel:latest

# --- Empresa (o mesmo ID usado no scripts/seed-cliente.mjs) ---
DEFAULT_ORG_ID=
DEFAULT_INSTANCE_NAME=atendimento_loja

# --- Supabase (Project Settings → API) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Evolution (WhatsApp) — criada por este compose ---
EVOLUTION_API_KEY=          # segredo novo
EVOLUTION_DB_PASSWORD=      # segredo novo

# --- Segredos do painel ---
WEBHOOK_SECRET=             # segredo novo (autentica as mensagens que chegam)
CRON_SECRET=                # segredo novo (autentica a rotina de espera)

# --- OpenAI (assistente e transcrição de áudio) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TZ=America/Sao_Paulo
