# Variáveis para rodar o painel (desenvolvimento ou servidor).
# Copie para .env.local e preencha. Nunca commitar o arquivo preenchido.

# --- Painel ---
# endereço público, sem barra no final
APP_BASE_URL=http://localhost:3000
# UUID da empresa na tabela organizations
DEFAULT_ORG_ID=
# nome da conexão principal na Evolution
DEFAULT_INSTANCE_NAME=atendimento_loja

# --- Supabase (NEXT_PUBLIC_* entram no build) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Evolution (WhatsApp) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Endereço que a Evolution usa para chamar o painel. Vazio = APP_BASE_URL.
WEBHOOK_BASE_URL=
# Token que autentica o webhook (obrigatório; sem ele nenhuma mensagem é aceita).
WEBHOOK_SECRET=

# --- Rotina automática (mensagem de espera) ---
CRON_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1
