# =============================================================================
# .env.example — Facilita Plus / pré-vendedor Caio
# Copie pra .env e preencha. Cada CLONE (VPS por cliente) tem o seu próprio .env.
# As 3 envs de TENANT no topo são as que MUDAM por cliente — não esquecer.
# =============================================================================

# --- App (público deste tenant) ---------------------------------------------
# URL base pública do painel. Usada pra montar o WEBHOOK_URL da Evolution e os
# links "Conversa: .../dashboard/contatos/..." enviados ao admin. SEM barra final.
APP_BASE_URL=https://app.facilitaplus.com.br

# --- Tenant (a org única deste sistema) -------------------------------------
# UUID da organização única deste tenant. Atribui todo inbound à org certa e
# resolve o redirect de /admin. CADA CLONE seta a sua (senão cai no fallback Facilita).
DEFAULT_ORG_ID=455b9a80-6bb9-461b-b62d-188f0a28c110
# Nome padrão da instância Evolution, usado como fallback quando o payload não traz.
DEFAULT_INSTANCE_NAME=facilita

# --- Supabase ----------------------------------------------------------------
# NEXT_PUBLIC_* são inlinadas no bundle no BUILD (precisam estar no docker build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (cérebro do Caio — PADRÃO FIXO: gpt-4o-mini) --------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# --- Evolution API (WhatsApp não-oficial / Baileys) -------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# 1 = Evolution processa o inbound direto (Chatwoot desligado). Padrão atual.
EVOLUTION_RECEBE=1
# Flags de teste de envio (deixe vazio em produção).
EVOLUTION_ENVIO_TESTE=
EVOLUTION_ENVIO_TODOS=

# --- ElevenLabs (voz do Caio) -----------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Admin / Cron ------------------------------------------------------------
# Número (com DDI/DDD) que recebe os avisos do Caio (handoff, agendamento, falha).
ADMIN_WHATSAPP_NUMBER=
# Bearer pros endpoints de /api/cron/* e /api/debug/*.
CRON_SECRET=

# --- Chatwoot (LEGADO — desligado quando EVOLUTION_RECEBE=1) -----------------
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
